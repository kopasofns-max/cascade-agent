# Backend identity (required in production by the application shell)
APP_ID=cascade-local
APP_SECRET=replace-with-a-long-random-string
DATABASE_URL=mysql://user:password@localhost:3306/cascade

# Worker and model providers — server-side only
WORKER_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Optional platform-provided Kimi gateway; do not copy local values into GitHub.
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=
GITHUB_TOKEN=

# Optional role overrides. Leave blank to discover models at runtime.
EXECUTOR_MODEL=
REVIEWER_MODEL=
FINAL_MODEL=

# Optional protection for a separately deployed API
CASCADE_API_TOKEN=
CORS_ORIGINS=https://kopasofns-max.github.io

# Sandbox: Docker is recommended; bwrap is the Linux fallback
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=node:22-bookworm
SANDBOX_INSTALL=true
SANDBOX_NETWORK=false
SANDBOX_CPUS=1
SANDBOX_MEMORY=2g
CHECK_TIMEOUT_MS=180000
INSTALL_TIMEOUT_MS=600000
WORKSPACE_ROOT=/tmp/cascade-agent
ALLOW_LOCAL_REPOS=false

# Frontend. For GitHub Pages these are set by .github/workflows/pages.yml.
VITE_API_URL=
VITE_STATIC_PREVIEW=false
VITE_BASE_PATH=/
